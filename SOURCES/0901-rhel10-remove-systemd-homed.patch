index 5108590d509e9694f28358d5c4c2e60a2be99183..ad762bc2d4a55ba44fe53dba035d5c220a8b877f 100644
--- a/profiles/local/README
+++ b/profiles/local/README
@@ -57,9 +57,6 @@ with-mdns4::
